# =========================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO — BARBER YANDER
# Renombra este archivo como ".env" y ajusta tus credenciales
# =========================================================

# --- BASE DE DATOS MYSQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=barber_yander
DB_SSL=false

# --- CONFIGURACIÓN DE CORREO SMTP (RECUPERACIÓN DE CONTRASEÑA) ---
# Ejemplo con Gmail: Servidor smtp.gmail.com, puerto 587 (TLS) o 465 (SSL)
# Nota para Gmail: Utilizar una "Contraseña de Aplicación" de 16 caracteres de Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion
SMTP_FROM=tu_correo@gmail.com
SMTP_FROM_NAME="Barbería Yander"
SMTP_SECURE=tls
